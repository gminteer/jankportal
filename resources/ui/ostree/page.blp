using Gtk 4.0;
using Adw 1;

template $OSTreePage: ScrolledWindow {
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;
    propagate-natural-height: true;

    child: Box container {
        orientation: vertical;
        valign: start;
        Label {
            label: _("Current Track");
            styles ["heading"]
            margin-top: 10;
        }

        ListBox {
            selection-mode: none;
            styles ["boxed-list", "root-list"]

            Adw.ActionRow {
                title: _("Image");
                activatable-widget: image;
                focusable: false;

                [suffix]
                DropDown image {
                    styles ["flat-dropdown"]
                }
            }

            Adw.ActionRow {
                title: _("Tag");
                activatable-widget: tag;
                focusable: false;

                [suffix]
                DropDown tag {
                    styles ["flat-dropdown"]
                }
            }
            Adw.ButtonRow img_reset {
                visible: false;
                activatable: true;
                title: _("Reset");
                start-icon-name: "view-refresh-symbolic";
            }

            Adw.ButtonRow img_rebase {
                visible: false;
                activatable: true;
                title: _("Rebase");
                styles ["destructive-action"]
                start-icon-name: "document-save-symbolic";
            }

        }

        Label {
            label: _("Deployments");
            styles ["heading"]
            margin-top: 10;
        }
    };
}
