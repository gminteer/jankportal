using Gtk 4.0;
using Adw 1;

template $OSTreeOverlayList: Box {
    orientation: vertical;
    styles ["boxed-list", "sublist"]

    Label {
        label: _("Overlaid Packages");
        styles ["heading"]
    }

    Adw.WrapBox box {
        margin-bottom: 4;
        margin-top: 4;
        child-spacing: 4;
        line-spacing: 4;
        justify: none;
        align: 0.5;
    }
}
