using Gtk 4.0;
using Adw 1;

template $YaftiDropDownRow : Adw.ActionRow {
    focusable: false;
    activatable-widget: drop_down;
    [suffix]
    Box emblem_box {
        name: "emblem-box";
        width-request: 16;
    }

    [suffix]
    DropDown drop_down {
        styles ["flat-dropdown"]
    }
}
