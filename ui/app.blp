using Gtk 4.0;
using Adw 1;
using Vte 3.91;

template $JankPortalWindow : Adw.ApplicationWindow {
    default-width: 1200;
    default-height: 600;
    title: _("Jank Portal");

    content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            [start]
            ToggleButton {
                icon-name: "xsi-sidebar-show-symbolic";
                tooltip-text: _("Show Navigation");
                active: bind split_view.show-sidebar bidirectional;
            }

            SearchEntry search {
                    placeholder-text: _("Search…");
            }

            [end]
            Button {
                icon-name: "xsi-help-about-symbolic";
                tooltip-text: _("About");
                clicked => $on_about_clicked();
            }
        }

        Adw.ToastOverlay overlay {
            Adw.BottomSheet bottom_sheet {
                open: false;
                can-close: false;
                can-open: false;
                show-drag-handle: false;

                content: Adw.OverlaySplitView split_view {
                    sidebar: Adw.ViewSwitcherSidebar stack_switcher {
                        stack: stack;
                    };
                    content: Adw.ViewStack stack {
                        vhomogeneous: false;
                    };
                };

                sheet:  Adw.ToolbarView {
                    [top]
                    Adw.HeaderBar sheet_header{
                        show-end-title-buttons: false;

                        [end]
                        ToggleButton keep_vte_open {
                            tooltip-text: _("Keep command runner open after command exits");
                            icon-name: "window-pin-symbolic";
                            styles ["circular"]
                            clicked => $on_keep_vte_open_clicked();
                        }

                        title-widget: Label command_label {
                            label: _("");
                            ellipsize: end;
                            styles ["heading"]
                        };
                    }

                    ScrolledWindow {
                        propagate-natural-height: true;

                        child: Adw.ClampScrollable {
                            orientation: vertical;
                            unit: sp;
                            maximum-size: 400;
                            vexpand: true;

                            Vte.Terminal vte {
                                vexpand: true;
                            }
                        };
                    }
                };
            }
        }
    };
}
