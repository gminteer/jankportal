using Gtk 4.0;
using Adw 1;

template $OSTreePage: ScrolledWindow {
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;
    propagate-natural-height: true;

    child: Box container {
        orientation: vertical;
        valign: start;
        Label {
            label: _("Current Track");
            styles ["heading"]
            margin-top: 10;
        }

        ListBox {
            styles ["boxed-list", "root-list"]

            Adw.ActionRow {
                title: _("Image");
                activatable-widget: image;

                [suffix]
                Gtk.DropDown image {
                    styles ["flat-dropdown"]
                }
            }

            Adw.ActionRow {
                title: _("Tag");
                activatable-widget: tag;

                [suffix]
                Gtk.DropDown tag {
                    styles ["flat-dropdown"]
                }
            }
        }

        Label {
            label: _("Deployments");
            styles ["heading"]
            margin-top: 10;
        }
    };
}
