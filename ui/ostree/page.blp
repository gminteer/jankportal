using Gtk 4.0;
using Adw 1;

template $OSTreePage: ScrolledWindow {
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;
    propagate-natural-height: true;
    child: Box container {
        orientation: vertical;
        valign: start;
        ListBox {
            styles ["boxed-list", "root-list"]

            Adw.ComboRow image {
                title: _("Image");
            }

            Adw.ComboRow tag {
                title: _("Tag");
            }
        }
    };
}
