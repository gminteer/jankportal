using Gtk 4.0;

template $YaftiPage: ScrolledWindow {
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;
    propagate-natural-height: true;
    child: Box {
      orientation: vertical;
      valign: start;

      Label description {
        label: _("Template");
        styles ["heading"]
        margin-top: 10;
      }

      ListBox action_list {
        selection-mode: none;
        styles ["boxed-list", "root-list"]
      }
    };
}
